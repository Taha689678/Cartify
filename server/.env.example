PORT=5000

CLIENT_URL=http://localhost:5173

MONGODB_URI=

# App
NODE_ENV=

# Email / SMTP - Mailtrap
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Sender
EMAIL_FROM=Cartify <no-reply@cartify.com>

# Email links
EMAIL_VERIFY_PATH=/verify-email
PASSWORD_RESET_PATH=/reset-password

# Expiration times
EMAIL_VERIFICATION_TTL_MS=
PASSWORD_RESET_TTL_MS=

#jwt
JWT_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayFast Configuration
PAYFAST_ENABLED=false
PAYFAST_ENVIRONMENT=sandbox
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_SECURE_KEY=your_payfast_secure_key
PAYFAST_RETURN_URL=http://localhost:5173/payment/success
PAYFAST_CALLBACK_URL=http://localhost:5000/api/payments/payfast/callback