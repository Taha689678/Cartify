PORT=5000

# The URL of your frontend application (e.g. https://your-cartify-store.com)
CLIENT_URL=http://localhost:5173

# Your MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cartify?retryWrites=true&w=majority

# App Environment (development | production)
NODE_ENV=production

# Email Provider Selection (gmail | mailtrap)
EMAIL_PROVIDER=mailtrap

# --- Mailtrap Configuration ---
# Get these credentials from your Mailtrap "Email Sending" dashboard.
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=api
SMTP_PASSWORD=
# NOTE: Mailtrap Email Sending requires your sending domain to be verified (SPF, DKIM, DMARC) in their dashboard.

# --- Gmail Configuration ---
# If EMAIL_PROVIDER=gmail, these will be used instead. Use an App Password, NOT your real account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Sender Address (Used by both providers)
EMAIL_FROM=Cartify <no-reply@yourdomain.com>

# Email links (Relative to CLIENT_URL)
EMAIL_VERIFY_PATH=/verify-email
PASSWORD_RESET_PATH=/reset-password

# Expiration times in milliseconds (e.g. 86400000 = 24 hours, 3600000 = 1 hour)
EMAIL_VERIFICATION_TTL_MS=86400000
PASSWORD_RESET_TTL_MS=3600000

# JWT Secrets (Generate secure random strings for these!)
# e.g. node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (Required for Product Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payfast Configuration (South African Payment Gateway)
PAYFAST_ENABLED=false
PAYFAST_ENVIRONMENT=sandbox
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_RETURN_URL=https://yourdomain.com/payment/success
PAYFAST_CANCEL_URL=https://yourdomain.com/payment/failed
PAYFAST_NOTIFY_URL=https://your-api-domain.com/api/payment/notify